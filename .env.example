# EIS local provider configuration template.
# Copy this file to .env and fill in values locally. Never commit .env.
# .env is ignored by Git; this template contains placeholders only.
#
# Official provider details were checked on 2026-11-20. See:
#   docs/EIS_MODEL_PROVIDER_CONFIGURATION.md
# Set one provider and its matching key. Do not enable providers you do not use.
# No provider is enabled unless EIS_MODEL_PROVIDER is set.

EIS_MODEL_PROVIDER=opencode
EIS_MODEL=deepseek-v4.1-flash
# OpenCode requires an explicit documented base URL because endpoints differ.
EIS_OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# Provider credentials: fill only the one you use. Placeholders only.
OPENCODE_API_KEY=replace-with-your-local-key
OPENAI_API_KEY=replace-with-your-local-key
GEMINI_API_KEY=replace-with-your-local-key
ANTHROPIC_API_KEY=replace-with-your-local-key
XAI_API_KEY=replace-with-your-local-key

# Optional request timeout in seconds (1-300).
# EIS_MODEL_TIMEOUT_SECONDS=60

# Consent is required before any external model call. C3 is never allowed.
# Uncomment only the classes you explicitly consent to send.
# EIS_MODEL_CONSENT_CLASSES=C0,C1
# EIS_MODEL_CONSENT_PURPOSE=model completion
